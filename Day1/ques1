class Solution {
    public int distributeCandies(int[] arr) {
        HashSet<Integer> set=new HashSet<>();
        for (int i = 0; i < arr.length; i++) {
            set.add(arr[i]);
        }
        if(arr.length/2<=set.size()){
            return arr.length/2;
        }
        return set.size();
    }
}
