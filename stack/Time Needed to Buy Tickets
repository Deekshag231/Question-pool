class Solution {
    public int timeRequiredToBuy(int[] arr, int k) {
        Deque<Integer> q=new LinkedList<>();
        for(int i=0;i<arr.length;i++){
            q.add(i);
        }
        int count=0;
        while(!q.isEmpty()){
            int idx=q.peekFirst();
            arr[idx]--;
            count++;
            if(arr[idx]<=0&&idx!=k){
                q.pollFirst();
            }
            else if(idx==k&&arr[idx]<=0){
                return count;
            }
            else{
                q.pollFirst();
                q.addLast(idx);
            }
        }
        return count;
    }
}
